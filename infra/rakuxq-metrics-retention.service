[Unit]
Description=Enforce RakuXQ anonymous event retention limits
After=rakuxq-api.service

[Service]
Type=oneshot
User=rakuxq
Group=rakuxq
UMask=0077
ExecCondition=/usr/bin/test -f /opt/raku/logs/rakuxq/public-metrics/public-metrics.sqlite3
ExecStart=/opt/raku/portable/rakuxq/current/.venv/bin/python -m rakuxq_api.metrics_cli --database /opt/raku/logs/rakuxq/public-metrics/public-metrics.sqlite3 --event-hours 720 --max-events 100000 --prune-only
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/raku/logs/rakuxq/public-metrics
